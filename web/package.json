{
  "name": "blocks-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Visual model builder for models/blocks with strict jaxtyping shape inference",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:logic": "node test-logic.ts",
    "test:e2e": "node test-e2e.ts",
    "test:info-tab": "node test-info-tab.ts",
    "test:runtime": "node test-runtime.ts",
    "test:subgraph-upto": "node test-subgraph-upto.ts",
    "test:mermaid": "node test-mermaid.ts",
    "test:autosave": "node test-autosave.ts",
    "test:tags-clipboard": "node test-tags-clipboard.ts",
    "test:groups": "node test-groups.ts",
    "test:group-dup-param": "node test-group-dup-param.ts",
    "test:nested-groups": "node test-nested-groups.ts",
    "test:bubble-params": "node test-bubble-params.ts",
    "test:elementwise": "node test-elementwise.ts",
    "test:nested-groups-e2e": "node test-nested-groups-e2e.ts",
    "test:group-copy-cycle": "node test-group-copy-cycle.ts",
    "test:history-paste-select": "node test-history-paste-select.ts",
    "test:group-name-sync": "node test-group-name-sync.ts",
    "test:group-optional-ports": "node test-group-optional-ports.ts",
    "test:group-residual-boundary": "node test-group-residual-boundary.ts",
    "test:inspector-reactivity": "node test-inspector-reactivity.ts",
    "test:tree-signature": "node test-tree-signature.ts",
    "test:tree-expand": "node test-tree-expand.ts",
    "test:tree-adapter": "node test-tree-adapter.ts",
    "test:tree": "node test-tree-signature.ts && node test-tree-expand.ts && node test-tree-adapter.ts",
    "test:forest-codegen-parity": "node test-forest-codegen-parity.ts"
  },
  "dependencies": {
    "@retejs/lit-plugin": "^2.0.5",
    "lit": "^3.2.1",
    "mermaid": "^11.15.0",
    "rete": "^2.0.6",
    "rete-area-plugin": "^2.1.5",
    "rete-connection-plugin": "^2.0.5",
    "rete-render-utils": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "puppeteer": "^25.1.0",
    "typescript": "^6.0.3",
    "vite": "^5.4.20"
  }
